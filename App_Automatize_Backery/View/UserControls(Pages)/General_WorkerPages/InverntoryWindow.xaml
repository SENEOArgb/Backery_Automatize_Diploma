<Window x:Class="App_Automatize_Backery.View.UserControls_Pages_.General_WorkerPages.InverntoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Automatize_Backery.View.UserControls_Pages_.General_WorkerPages"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:supportviewmodel="clr-namespace:App_Automatize_Backery.ViewModels.SupportViewModel" d:DataContext="{d:DesignInstance Type=supportviewmodel:InventoryViewModel}"
        mc:Ignorable="d"
        Title="InverntoryWindow" Height="600" Width="900"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding GroupedWarehouseItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding RawMaterialName}"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="#2E3A59"
                                  Margin="0,0,0,15"
                                  Background="{DynamicResource MaterialDesignCardBackground}">
                            <ItemsControl ItemsSource="{Binding Supplies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="5"
                                                Padding="10"
                                                Background="{DynamicResource MaterialDesignPaper}"
                                                BorderThickness="1"
                                                BorderBrush="#DDD"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="Дата поставки: " FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DateSupplyOrProduction, StringFormat={}{0:dd.MM.yyyy}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="Количество: " FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding RawMaterialCount}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Дата инвентаризации -->
        <TextBlock Grid.Row="1"
                   Text="{Binding InventoryDateTime, StringFormat=Инвентаризация от {0:dd.MM.yyyy HH:mm}}"
                   FontStyle="Italic"
                   HorizontalAlignment="Center"
                   Margin="0,10"/>

        <!-- Кнопка генерации отчета -->
        <Button Grid.Row="2"
                Content="Сформировать отчёт по инвентаризации"
                Command="{Binding GenerateInventoryReportCommand}"
                Margin="0,10"
                HorizontalAlignment="Center"
                Style="{StaticResource MaterialDesignRaisedButton}"/>
    </Grid>
</Window>
