<Window x:Class="App_Automatize_Backery.View.Windows.RPP.CreateRPPWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Automatize_Backery.View.Windows.RPP"
        mc:Ignorable="d"
        Title="CreateRPPWindow" Height="250" Width="400">
    <Grid Margin="20">
        <StackPanel>
            <RadioButton Content="За сегодня" IsChecked="{Binding IsToday}" />
            <RadioButton Content="За период" IsChecked="{Binding IsPeriod}" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsPeriod, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="C:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="120" Margin="0,0,10,0"/>
                <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="120"/>
            </StackPanel>

            <Button Content="Сформировать" Command="{Binding GenerateRPPReportCommand}" Margin="0,20,0,0" Width="140" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</Window>
